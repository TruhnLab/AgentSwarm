# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# One endpoint, or several comma-separated (used round-robin; split among the prompts when several are run)
SWARM_BASE_URL=https://api.example.com/v1
SWARM_API_KEY=your-api-key-here
SWARM_MODEL=your-model-name

# Optional
# SWARM_CONTEXT_TOKENS=100000        # context budget per agent before it compacts into a handoff note
# SWARM_EXTRA_BODY={"max_tokens": 8192}   # extra request fields as JSON (sampling, thinking switches, ...)
# SWARM_KEEP_REASONING=1             # send the model's reasoning back in the history (e.g. vLLM preserve_thinking)
# SWARM_VISION=1                     # the model takes images: agents get `view_image` to look at the plots they make
